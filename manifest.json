{
  "manifest_version": 3,
  "name": "SubLingo — английский по фильмам и YouTube",
  "short_name": "SubLingo",
  "version": "1.6.3",
  "author": "pheromone",
  "description": "Двойные субтитры на YouTube и Netflix, словарь по клику, сохранение слов, карточки с интервальным повторением, режим чтения.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SubLingo",
    "default_popup": "pages/popup.html"
  },
  "options_page": "pages/options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "scripting",
    "tts",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "page/yt-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "common/freq.js",
        "common/lib.js",
        "content/ui-css.js",
        "content/dict.js",
        "content/core.js",
        "content/web.js",
        "content/yt.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.netflix.com/*"
      ],
      "js": [
        "page/nf-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.netflix.com/*"
      ],
      "js": [
        "common/freq.js",
        "common/lib.js",
        "content/ui-css.js",
        "content/dict.js",
        "content/core.js",
        "content/web.js",
        "content/nf.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "https://*.netflix.com/*"
      ],
      "js": [
        "page/sniff-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "https://*.netflix.com/*"
      ],
      "js": [
        "common/lib.js",
        "content/ui-css.js",
        "content/dict.js",
        "content/web.js",
        "content/generic.js"
      ],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Открыть SubLingo"
    }
  }
}